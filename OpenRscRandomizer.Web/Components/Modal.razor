@if (IsOpen)
{
    <div @onclick="Close" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
        <div @onclick:stopPropagation="true" class="w-full max-w-md rounded-xl bg-white p-6 shadow-xl">
            <div class="flex items-center justify-between border-b pb-3">
                <h3 class="text-lg font-semibold text-gray-900">@Title</h3>
                <button @onclick="Close" class="text-gray-400 hover:text-gray-600">✕</button>
            </div>
            <div class="py-4">
                @ChildContent
            </div>
            @if (FooterContent is not null)
            {
                <div class="flex justify-end gap-3 border-t pt-3">
                    @FooterContent
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? FooterContent { get; set; }

    private async Task Close() => await IsOpenChanged.InvokeAsync(false);
}